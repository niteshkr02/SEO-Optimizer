{
  "name": "seo-optimizer-frontend-root",
  "version": "0.1.0",
  "private": true,
  "description": "SEO Optimizer — Frontend Workspaces & Tooling",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "build:web": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web",
    "lint:web": "npm run lint --workspace=web",
    "test": "npm run test --workspace=web",
    "test:web": "npm run test --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "typecheck:web": "npm run typecheck --workspace=web",
    "prisma": "npm run prisma --workspace=web"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
